{
  "slug": "quick-roasted-venezuelan-cookie-bake",
  "title": "Venezuelan Beef Empanadas",
  "description": "Delicious beef empanadas with a crispy crust, inspired by Venezuelan cuisine. Perfect for a snack or dinner.",
  "cuisine": "venezuelan",
