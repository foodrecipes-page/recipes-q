{
  "title": "Quick Japanese Tofu Agedashi",
  "description": "Rich and pillowy Japanese dish featuring hot smoked paprika and lardons-render, perfect for a gluten-free friendly meal",
  "cuisine": "Japanese",
  "diet": [
    "gluten-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "Silken tofu",
      "amount": "1 block",
      "notes": "drained and cut into small cubes"
    },
    {
      "name": "Hot smoked paprika",
      "amount": "1 tsp"
    },
    {
      "name": "Lardons",
      "amount": "4 slices",
      "notes": "rendered and crispy"
    },
    {
      "name": "Dashi broth",
      "amount": "2 cups"
    },
    {
      "name": "Mirin",
      "amount": "1 tbsp"
    },
    {
      "name": "Soy sauce",
      "amount": "1 tbsp"
    },
    {
      "name": "Rice vinegar",
      "amount": "1 tsp"
    },
    {
      "name": "Green onions",
      "amount": "1/4 cup",
      "notes": "thinly sliced"
    },
    {
      "name": "Sesame oil",
      "amount": "1 tsp"
    },
    {
      "name": "Salt",
      "amount": "1/2 tsp"
    }
  ],
  "instructions": [
    "Heat the sesame oil in a large saucepan over medium heat",
    "Add the lardons and cook until crispy and golden brown",
    "Remove the lardons from the saucepan and set aside",
    "Add the dashi broth, mirin, soy sauce, and rice vinegar to the saucepan",
    "Bring the mixture to a simmer and cook for 5 minutes",
    "Add the silken tofu to the saucepan and cook for 2-3 minutes on each side",
    "Remove the tofu from the saucepan and place on a plate",
    "Sprinkle the hot smoked paprika, crispy lardons, and green onions over the tofu",
    "Serve immediately and enjoy"
  ],
