{
  "title": "Quick-Fix Rich Filipino Egg Bake",
  "description": "A rich, aerated Filipino dish featuring free-range eggs, perfect for a quick breakfast or brunch. This egg bake is onion-free and garlic-free, making it a great option for those who don't like pungent flavors.",
  "cuisine": "Filipino",
  "diet": [
    "vegetarian"
  ],
  "meal": "breakfast",
  "ingredients": [
    {
      "name": "Free-range eggs",
      "amount": "6",
      "notes": "large eggs"
    },
    {
      "name": "All-purpose flour",
      "amount": "1 1/2 cups",
      "notes": "unbleached"
    },
    {
      "name": "Milk",
      "amount": "1 cup",
      "notes": "whole milk"
    },
    {
      "name": "Unsalted butter, melted",
      "amount": "2 tablespoons",
      "notes": "for greasing the baking dish"
    },
    {
      "name": "Shredded cheddar cheese",
      "amount": "1 cup",
      "notes": "divided"
    },
    {
      "name": "Grated ginger",
      "amount": "1 teaspoon",
      "notes": "fresh ginger"
    },
    {
      "name": "Soy sauce",
      "amount": "1 tablespoon",
      "notes": "for added depth of flavor"
    },
    {
      "name": "Salt",
      "amount": "1/4 teaspoon",
      "notes": "to taste"
    },
    {
      "name": "Black pepper",
      "amount": "1/4 teaspoon",
      "notes": "to taste"
    }
  ],
  "instructions": [
    "Preheat the oven to 375°F (190°C).",
    "Grease a 9x13-inch baking dish with the melted butter.",
    "In a large bowl, whisk together the eggs, milk, shredded cheddar cheese, grated ginger, soy sauce, salt, and black pepper.",
    "Pour the egg mixture into the prepared baking dish.",
    "Bake for 25-30 minutes or until the eggs are set and the cheese is melted and golden brown.",
    "Remove the egg bake from the oven and let it cool for a few minutes before slicing and serving.",
    "Serve warm and enjoy!"
  ],
