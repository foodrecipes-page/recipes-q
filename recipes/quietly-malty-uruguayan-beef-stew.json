{
  "title": "Quietly Malty Uruguayan Beef Stew",
  "description": "A hearty and comforting Uruguayan beef stew with a malty flavor, featuring ketchup and a silky texture, perfect for a weeknight dinner",
  "cuisine": "Uruguayan",
  "diet": [
    "raw-friendly"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "beef stew meat",
      "amount": "1 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "ketchup",
      "amount": "1/2 cup"
    },
    {
      "name": "malt extract",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "dried oregano",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "beef broth",
      "amount": "2 cups"
    }
  ],
  "instructions": [
    "Heat a large copper mug over medium heat",
    "Add the chopped onion and cook until softened, about 5 minutes",
    "Add the minced garlic and cook for an additional 1 minute",
    "Add the beef stew meat and cook until browned on all sides, about 5 minutes",
    "Add the ketchup, malt extract, dried oregano, salt, and black pepper, stirring to combine",
    "Add the beef broth and bring to a boil, then reduce the heat to low and simmer, covered, for 1 1/2 hours",
    "Remove the stew from the heat and let it cool slightly before serving",
    "Serve the stew hot, garnished with chopped fresh herbs if desired"
  ],
