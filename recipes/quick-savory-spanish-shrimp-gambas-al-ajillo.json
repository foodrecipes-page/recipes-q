      "name": "large shrimp",
      "amount": "1 pound",
      "notes": "peeled and deveined"
    },
    {
      "name": "brown rice",
      "amount": "1 cup",
      "notes": "cooked"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "chopped fresh parsley",
      "amount": "1/4 cup"
    },
    {
      "name": "red pepper flakes",
      "amount": "1/4 teaspoon",
      "notes": "optional"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large skillet over medium-high heat",
    "Add the garlic and cook for 1 minute, until fragrant",
    "Add the shrimp and cook for 2-3 minutes per side, until pink and cooked through",
    "Remove the shrimp from the skillet and set aside",
    "Add the smoked paprika, salt, black pepper, and red pepper flakes to the skillet and cook for 1 minute",
    "Add the cooked brown rice to the skillet and stir to combine with the spices",
    "Return the shrimp to the skillet and stir to combine with the rice and spices",
    "Squeeze the lemon juice over the top of the shrimp and rice",
    "Sprinkle the chopped parsley over the top of the dish",
    "Serve immediately"
  ],
