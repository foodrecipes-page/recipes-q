  "ingredients": [
    {
      "name": "boneless chicken thighs",
      "amount": "1 1/2 pounds",
      "notes": "cut into 2-inch pieces"
    },
    {
      "name": "ssamjang",
      "amount": "1/4 cup"
    },
    {
      "name": "coconut oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1-inch piece",
      "notes": "grated"
    },
    {
      "name": "fish sauce",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "water",
      "amount": "2 cups"
    }
  ],
  "instructions": [
    "Heat the coconut oil in the clay pot over medium heat.",
    "Add the chopped onion and cook until it is translucent, about 5 minutes.",
    "Add the minced garlic and grated ginger and cook for 1 minute, stirring constantly.",
    "Add the chicken pieces and cook until they are browned on all sides, about 5-7 minutes.",
    "Add the ssamjang, fish sauce, salt, and black pepper, and stir to combine.",
    "Add the water to the clay pot and bring the mixture to a boil.",
    "Reduce the heat to low and simmer, covered, for 25 minutes, or until the chicken is cooked through.",
    "Serve the stew hot, garnished with chopped scallions and a sprinkle of salt."
  ],
