{
  "title": "Quaint Comforting Malaysian Chicken Stew",
  "description": "A briny and shaggy Malaysian stew featuring ssamjang, cooked to perfection in a clay pot, Whole30-friendly and full of comforting flavors.",
  "cuisine": "Malaysian",
  "diet": [
    "Whole30",
    "gluten-free"
