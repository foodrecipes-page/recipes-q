{
  "title": "Quick Crunchy Norwegian Fish Skewers",
  "description": "A kid-friendly Norwegian dish featuring fish, Dutch stroop, and beurre-monte, perfect for a quick and easy dinner",
  "cuisine": "Norwegian",
  "diet": [
    "low-glycemic",
    "kid-friendly"
  ],
