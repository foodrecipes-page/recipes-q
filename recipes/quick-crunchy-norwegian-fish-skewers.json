  "ingredients": [
    {
      "name": "cod fillets",
      "amount": "1 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "Dutch stroop",
      "amount": "1/4 cup"
    },
    {
      "name": "beurre-monte",
      "amount": "2 tablespoons"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "panko breadcrumbs",
      "amount": "1/2 cup"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit",
    "Thread the cod pieces onto skewers",
    "In a small bowl, mix together the Dutch stroop, beurre-monte, lemon juice, olive oil, salt, and black pepper",
    "Brush the mixture onto the cod pieces",
    "Roll the cod pieces in the panko breadcrumbs to coat",
    "Place the skewers on a baking sheet lined with parchment paper",
    "Bake for 12 minutes or until the fish is cooked through",
    "Serve hot and enjoy"
  ],
