      "name": "yogurt",
      "amount": "1 cup",
      "notes": "plain, non-fat"
    },
    {
      "name": "creme fraiche",
      "amount": "1/2 cup",
      "notes": "cultured"
    },
    {
      "name": "orange juice",
      "amount": "1/2 cup"
    },
    {
      "name": "lemon juice",
      "amount": "1/4 cup"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "honey",
      "amount": "1 tablespoon"
    },
    {
      "name": "cardamom",
      "amount": "1/2 teaspoon",
      "notes": "ground"
    },
    {
      "name": "ice",
      "amount": "1 cup",
      "notes": "crushed"
    }
  ],
  "instructions": [
    "In a blender, combine the yogurt, creme fraiche, orange juice, lemon juice, grated ginger, and honey",
    "Blend the mixture on high speed until smooth and creamy",
    "Add the ground cardamom and blend until well combined",
    "Taste and adjust the sweetness and flavor as needed",
    "Add the crushed ice to the blender and blend until the ice is fully incorporated and the drink is thick and frosty",
    "Pour the lassi into glasses and serve immediately",
    "Garnish with a sprinkle of ground cardamom, if desired"
  ],
