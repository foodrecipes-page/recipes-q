  "ingredients": [
    {
      "name": "Spanish peppers",
      "amount": "12 large",
      "notes": "any color"
    },
    {
      "name": "Olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "Salt",
      "amount": "to taste"
    },
    {
      "name": "Lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "Garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "Fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "Water",
      "amount": "4 cups",
      "notes": "for blanching"
    },
    {
      "name": "Ice",
      "amount": "2 cups",
      "notes": "for ice bath"
    }
  ],
  "instructions": [
    "Bring the water to a boil in a large pot and prepare an ice bath in a large bowl.",
    "Cut the tops off the peppers and remove the seeds and membranes.",
    "Blanch the peppers in the boiling water for 5 minutes.",
    "Immediately transfer the peppers to the ice bath to stop the cooking process.",
    "Once cooled, cut the peppers into large pieces and thread onto skewers.",
    "Drizzle the olive oil over the peppers and sprinkle with salt and garlic.",
    "Squeeze the lemon juice over the peppers and garnish with parsley.",
    "Serve the skewers chilled or at room temperature."
  ],
