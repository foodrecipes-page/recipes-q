{
  "title": "Quick Blanched Spanish Peppers Skewers",
  "description": "A crisp and refreshing Andalusian dish featuring blanched peppers, perfect for a crowd, with a macrobiotic twist to reduce bitterness",
  "cuisine": "Spanish",
