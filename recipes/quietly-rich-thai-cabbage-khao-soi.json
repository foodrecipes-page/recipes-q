  "instructions": [
    "Heat the oil in a large pan over medium heat.",
    "Add the shallots and garlic and saute until fragrant.",
    "Add the curry paste and cook for 1 minute.",
    "Add the coconut milk and bring to a simmer.",
    "Add the cabbage leaves and cook until wilted.",
    "Add the fish sauce and palm sugar and stir to combine.",
    "Add the rice noodles and cook until tender.",
    "Add the bean sprouts and stir to combine.",
    "Season with salt and pepper to taste.",
    "Serve hot and enjoy."
