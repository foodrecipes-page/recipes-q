{
  "title": "Quick Crispy Korean Almonds Muchim",
  "description": "A nutty, crispy Korean snack that showcases almonds sautéed with onions, garlic, and a savory sauce.",
  "cuisine": "Korean",
  "diet": [
    "dairy-free"
  ],
  "meal": "snack",
  "ingredients": [
    {
      "name": "almonds",
      "amount": "1 cup (shelled)",
      "notes": "shelled"
    },
    {
      "name": "onion",
      "amount": "1 small, thinly sliced"
    },
    {
      "name": "garlic",
      "amount": "1 clove, minced"
    },
    {
      "name": "sesame oil",
      "amount": "1 teaspoon"
    },
    {
      "name": "soy sauce",
      "amount": "1 tablespoon"
    },
    {
      "name": "gochugaru",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "¼ teaspoon"
    },
    {
      "name": "toasted sesame seeds",
      "amount": "1 tablespoon"
    },
    {
      "name": "scallions",
      "amount": "2 stalks, sliced",
      "notes": "optional garnish"
    }
  ],
  "instructions": [
    "Heat a non-stick skillet over medium heat.",
    "Add sesame oil and allow it to shimmer.",
    "Add sliced onion and sauté until translucent, about 3 minutes.",
    "Add minced garlic and continue cooking for 30 seconds until fragrant.",
    "Add almonds and stir until they begin to toast, about 4 minutes.",
    "Pour soy sauce, sprinkle gochugaru and black pepper, and stir to coat the almonds.",
    "Cook for another 2 minutes, letting the sauce thicken slightly.",
    "Transfer the mixture to a bowl and let it cool a little.",
    "Sprinkle toasted sesame seeds over the top.",
    "Garnish with sliced scallions if desired and serve immediately."
  ],
