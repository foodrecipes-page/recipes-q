{
  "title": "Quietly Comforting Dutch Barramundi Stew",
  "description": "A light and comforting Dutch stew featuring garlicky barramundi, perfect for a quiet evening at home.",
  "cuisine": "Dutch",
  "diet": [
    "pescatarian",
    "egg-free"
  ],
