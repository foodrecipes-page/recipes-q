  "ingredients": [
    {
      "name": "barramundi fillets",
      "amount": "4 pieces",
      "notes": "fresh or frozen, thawed"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and sliced"
    },
    {
      "name": "potatoes",
      "amount": "2 medium",
      "notes": "peeled and cubed"
    },
    {
      "name": "chicken broth",
      "amount": "2 cups",
      "notes": "low sodium"
    },
    {
      "name": "white wine",
      "amount": "1 cup",
      "notes": "dry"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat the oil in a large pot over medium heat.",
    "Add the garlic and onion and cook until the onion is translucent.",
    "Add the carrots and potatoes and cook for 5 minutes.",
    "Add the barramundi fillets and cook for 2 minutes on each side.",
    "Add the chicken broth and white wine and bring to a boil.",
    "Reduce the heat to low and simmer for 10 minutes.",
    "Stir in the chopped parsley and season with salt and pepper to taste.",
    "Serve hot and enjoy."
  ],
