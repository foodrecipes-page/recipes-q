  "instructions": [
    "Peel and dice potatoes into 1-inch cubes.",
    "Slice onion and mince garlic.",
    "Heat olive oil in a large pot over medium heat.",
    "Add onion and cook until translucent, about 5 minutes.",
    "Stir in garlic and smoked paprika, cooking for 1 minute.",
    "Add potatoes, bay leaves, salt, pepper, vegetable broth, and water, bring to a simmer.",
    "Cover and cook for 20 minutes, stirring occasionally, until potatoes are tender.",
    "Remove bay leaves, garnish with chopped parsley, and serve hot."
