      "amount": "1 cup",
      "notes": "homemade or store-bought"
    },
    {
      "name": "coconut oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "ground cumin",
      "amount": "1 teaspoon"
    },
    {
      "name": "smoked paprika",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "cayenne pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "vegetable broth",
      "amount": "2 cups"
    },
    {
      "name": "diced tomatoes",
      "amount": "1 can"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Heat the coconut oil in a large pot over medium heat.",
    "Add the chopped challots and cook until they are softened and lightly browned.",
    "Add the ground cumin, smoked paprika, and cayenne pepper, and cook for 1 minute.",
    "Add the confit-tomato, vegetable broth, diced tomatoes, salt, and black pepper, and stir to combine.",
    "Bring the stew to a boil, then reduce the heat to low and simmer for 20 minutes.",
    "Taste and adjust the seasoning as needed.",
    "Serve the stew hot, garnished with chopped fresh herbs if desired."
  ],
