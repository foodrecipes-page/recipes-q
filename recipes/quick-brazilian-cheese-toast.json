  "ingredients": [
    {
      "name": "yuzu juice",
      "amount": "2 tablespoons",
      "notes": "freshly squeezed"
    },
    {
      "name": "gruyere cheese",
      "amount": "1 cup",
      "notes": "shredded"
    },
    {
      "name": "parmesan cheese",
      "amount": "1/2 cup",
      "notes": "shredded"
    },
    {
      "name": "bread",
      "amount": "4 slices",
      "notes": "crusty bread"
    },
    {
      "name": "turmeric",
      "amount": "1 teaspoon",
      "notes": "ground"
    },
    {
      "name": "paprika",
      "amount": "1/2 teaspoon",
      "notes": "smoked"
    },
    {
      "name": "garlic powder",
      "amount": "1/2 teaspoon",
      "notes": "optional"
    },
    {
      "name": "olive oil",
      "amount": "1 tablespoon",
      "notes": "for brushing"
    }
  ],
  "instructions": [
    "Preheat the fondue pot to 180 degrees Fahrenheit.",
    "In a small bowl, mix together yuzu juice, turmeric, paprika, and garlic powder.",
    "Add the shredded gruyere and parmesan cheese to the fondue pot.",
    "Pour the yuzu mixture over the cheese and stir until well combined.",
    "Brush the slices of bread with olive oil.",
    "Dip the bread slices into the cheese mixture and cook for 2-3 minutes or until golden brown.",
    "Serve immediately and enjoy.",
    "Repeat the dipping process until all the cheese is used up.",
    "Clean the fondue pot with warm soapy water after use."
  ],
