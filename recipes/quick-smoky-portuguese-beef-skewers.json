{
  "title": "Quick Smoky Portuguese Beef Skewers",
  "description": "A garlicky and crispy Portuguese dish featuring feather blade beef, this recipe is perfect for a low-carb and energizing meal. It is smoke-cold and full of flavor.",
  "cuisine": "Portuguese",
  "diet": [
    "low-carb",
    "gluten-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "feather blade beef",
      "amount": "1 pound",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "paprika",
      "amount": "1 tablespoon"
    },
    {
      "name": "smoked salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "bay leaves",
      "amount": "2 leaves"
    }
  ],
  "instructions": [
    "Preheat the grill to medium-high heat.",
    "In a large bowl, whisk together paprika, smoked salt, black pepper, garlic, and olive oil.",
    "Add the beef to the bowl and toss to coat.",
    "Thread the beef onto skewers, leaving a small space between each piece.",
    "Grill the skewers for 8-10 minutes, turning occasionally.",
    "Brush the skewers with lemon juice during the last 2 minutes of cooking.",
    "Remove the skewers from the grill and sprinkle with bay leaves.",
    "Let the skewers rest for 5 minutes before serving.",
    "Serve the skewers hot and enjoy."
  ],
