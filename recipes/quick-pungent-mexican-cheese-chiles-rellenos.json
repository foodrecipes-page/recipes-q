      "name": "filo pastry",
      "amount": "1 package",
      "notes": "thawed"
    },
    {
      "name": "roasted poblano peppers",
      "amount": "4",
      "notes": "peeled and seeded"
    },
    {
      "name": "monterey jack cheese",
      "amount": "1 cup",
      "notes": "shredded"
    },
    {
      "name": "onion",
      "amount": "1/2 cup",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "cumin",
      "amount": "1 tsp"
    },
    {
      "name": "paprika",
      "amount": "1/2 tsp"
    },
    {
      "name": "salt",
      "amount": "1/4 tsp"
    },
    {
      "name": "pepper",
      "amount": "1/4 tsp"
    },
    {
      "name": "egg",
      "amount": "1",
      "notes": "beaten"
    }
  ],
  "instructions": [
    "Preheat the broiler.",
    "In a bowl, mix together the cheese, onion, garlic, cumin, paprika, salt, and pepper.",
    "Lay a filo pastry sheet flat and place a roasted poblano pepper in the center.",
    "Spoon the cheese mixture into the pepper, filling it as full as possible.",
    "Brush the edges of the filo pastry with the beaten egg.",
    "Fold the filo pastry over the pepper, pressing the edges to seal.",
    "Repeat with the remaining peppers and filo pastry.",
    "Place the filled peppers on a baking sheet and broil for 5 minutes, or until the pastry is golden brown.",
    "Serve hot and enjoy."
  ],
