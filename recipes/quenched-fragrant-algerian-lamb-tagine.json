  "instructions": [
    "Heat the tandoor clay pot over medium-high heat.",
    "Add the olive oil and sear the lamb until browned on all sides.",
    "Remove the lamb from the pot and set aside.",
    "Add the chopped onion to the pot and cook until softened.",
    "Add the minced garlic and grated ginger to the pot and cook for 1 minute.",
    "Add the cumin, coriander, cinnamon, and cayenne pepper to the pot and cook for 1 minute.",
    "Add the browned lamb back to the pot.",
    "Add the chopped chervil and cook for 1 minute.",
    "Pour in the coconut milk and bring the mixture to a simmer.",
    "Reduce the heat to low and cover the pot with a lid.",
    "Pressure cook the lamb for 20 minutes.",
    "Let the lamb rest for 5 minutes before serving."
  ],
