    },
    {
      "name": "almond flour",
      "amount": "2 cups"
    },
    {
      "name": "granulated sweetener",
      "amount": "1 cup"
    },
    {
      "name": "unsalted butter",
      "amount": "1/2 cup",
      "notes": "melted"
    },
    {
      "name": "garlic powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "sea salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "large eggs",
      "amount": "4"
    },
    {
      "name": "shredded coconut",
      "amount": "1 cup"
    }
  ],
  "instructions": [
    "Preheat the oven to 350 degrees Fahrenheit.",
    "Mix the almond flour, granulated sweetener, and garlic powder in a large bowl.",
    "Add the melted butter, sea salt, and large eggs to the bowl and mix until well combined.",
    "Fold in the chopped Mars bars and shredded coconut.",
    "Press the mixture into a lined or greased 8x8 inch baking dish.",
    "Bake for 20 minutes or until the edges are lightly golden.",
    "Remove from the oven and let cool completely.",
    "Cut into bars and serve."
  ],
