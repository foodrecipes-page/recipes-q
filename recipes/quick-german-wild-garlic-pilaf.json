{
  "title": "Quick German Wild Garlic Pilaf",
  "description": "A fresh and bouncy German dish to start your day, featuring the flavors of wild garlic and miso.",
  "cuisine": "german",
  "diet": [
    "low-fat"
  ],
  "meal": "breakfast",
  "ingredients": [
    {
      "name": "wild garlic leaves",
      "amount": "2 cups",
      "notes": "freshly picked"
    },
    {
      "name": "white rice",
      "amount": "1 cup",
      "notes": "preferably day-old"
    },
    {
      "name": "miso paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "chicken broth",
      "amount": "2 cups"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "grated cheddar cheese (optional)",
      "amount": "1/4 cup"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large saucepan over medium heat.",
    "Add the chopped wild garlic leaves and sauté for 1-2 minutes until fragrant.",
    "Add the white rice and cook for 1-2 minutes, stirring constantly.",
    "Add the chicken broth, miso paste, salt, and black pepper. Stir to combine.",
    "Bring the mixture to a boil, then reduce the heat to low, cover, and simmer for 15 minutes.",
    "Remove the saucepan from the heat and stir in the lemon juice.",
    "Fluff the pilaf with a fork and serve hot, topped with grated cheddar cheese if desired."
  ],
