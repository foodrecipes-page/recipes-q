  "ingredients": [
    {
      "name": "sirloin steak",
      "amount": "1",
      "notes": "1.5 pounds, cut into 1-inch pieces"
    },
    {
      "name": "kombu-cold-extract",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "onion",
      "amount": "1 medium, chopped"
    },
    {
      "name": "bell pepper",
      "amount": "1 medium, chopped"
    },
    {
      "name": " Scotch bonnet pepper",
      "amount": "1 teaspoon, minced"
    },
    {
      "name": "allspice",
      "amount": "1 teaspoon"
    },
    {
      "name": "thyme",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large skillet over medium-high heat.",
    "Add the chopped onion and bell pepper and cook until they start to soften, about 3 minutes.",
    "Add the sirloin steak and cook until browned on all sides, about 5 minutes.",
    "Add the kombu-cold-extract, Scotch bonnet pepper, allspice, thyme, salt, and black pepper to the skillet and stir to combine.",
    "Continue to cook the steak and vegetables for another 5-7 minutes, or until the steak is cooked to your desired level of doneness.",
    "Serve the skillet hot, garnished with chopped fresh herbs if desired."
  ],
