{
  "title": "Quenched Brazilian Lentil Salad",
  "description": "A bright, tangy lentil salad with a hint of cocoa, pickles, and Mediterranean herbs, perfect for a quick, energizing lunch.",
  "cuisine": "Brazilian",
  "diet": [
    "vegan",
    "gluten-free",
