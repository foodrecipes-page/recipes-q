  "instructions": [
    "preheat oven to 350f",
    "line a baking sheet with parchment paper",
    "mix peanut butter, coconut sugar, eggs, vanilla extract, and salt in a large bowl",
    "add chopped peanuts and mix until combined",
    "drop spoonfuls of the mixture onto the prepared baking sheet",
    "bake for 12 minutes or until the edges are lightly golden",
    "remove from oven and sprinkle with flaky sea salt",
    "let cool for 5 minutes before transferring to a wire rack",
    "serve warm with a dollop of coconut cream crack",
    "serve immediately"
  ],
