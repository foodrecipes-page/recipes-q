      "amount": "2 tbsp"
    },
    {
      "name": "onion",
      "amount": "1 medium, diced"
    },
    {
      "name": "garlic cloves",
      "amount": "2, minced"
    },
    {
      "name": "spice blend (cumin, coriander, paprika, cinnamon)",
      "amount": "1 tsp"
    },
    {
      "name": "date syrup",
      "amount": "2 tbsp"
    },
    {
      "name": "almonds",
      "amount": "50g, toasted"
