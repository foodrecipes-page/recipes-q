      "amount": "2 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "carrots",
      "amount": "4 medium",
      "notes": "peeled, chopped"
    },
