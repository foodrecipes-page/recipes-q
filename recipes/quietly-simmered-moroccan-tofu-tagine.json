    },
    {
      "name": "paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "turmeric",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large clay or ceramic tagine or Dutch oven over medium heat",
    "Add the chopped onion and cook until it is softened and lightly browned",
    "Add the minced garlic and grated ginger and cook for 1 minute",
    "Add the cumin, paprika, turmeric, salt, and black pepper and cook for 1 minute",
    "Add the cubed tofu and cook until it is lightly browned on all sides",
    "Add the soya milk and bring the mixture to a simmer",
    "Reduce the heat to low and cook, covered, for 20 minutes",
    "Serve the tagine hot, garnished with fresh parsley or cilantro"
  ],
