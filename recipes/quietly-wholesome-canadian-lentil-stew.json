      "name": "brown lentils",
      "amount": "1 cup",
      "notes": "rinsed and drained"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "celery",
      "amount": "2 stalks",
      "notes": "chopped"
    },
    {
      "name": "red wine",
      "amount": "1 cup"
    },
    {
      "name": "shio-koji",
      "amount": "2 tablespoons"
    },
    {
      "name": "tomato paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "vegetable broth",
      "amount": "4 cups"
    },
    {
      "name": "dried thyme",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "In a large pot, combine the lentils, carrots, celery, and vegetable broth, and bring to a boil over high heat.",
    "Reduce the heat to low and simmer, covered, for 30 minutes, or until the lentils are tender.",
    "In a small bowl, whisk together the red wine, shio-koji, tomato paste, thyme, salt, and pepper.",
    "Stir the wine mixture into the lentil mixture and continue to simmer, uncovered, for 10 minutes, or until the stew has thickened slightly.",
    "Taste and adjust the seasoning as needed.",
    "Serve hot, garnished with chopped fresh herbs, if desired."
  ],
