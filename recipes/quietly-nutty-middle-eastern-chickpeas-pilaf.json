      "amount": "1 cup",
      "notes": "canned, drained, and rinsed"
    },
    {
      "name": "thai red curry paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "bhuna spice mix",
      "amount": "1 teaspoon"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "basmati rice",
      "amount": "1 cup"
    },
    {
      "name": "water",
      "amount": "2 cups"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "chopped almonds",
      "amount": "1/4 cup",
      "notes": "for garnish"
    }
  ],
  "instructions": [
    "Heat the olive oil in a paella pan over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the minced garlic and cook for 1 minute, until fragrant.",
    "Add the thai red curry paste and bhuna spice mix, and cook for 1 minute, stirring constantly.",
    "Add the chickpeas, basmati rice, water, and salt, and stir to combine.",
    "Bring the mixture to a boil, then reduce the heat to low, cover, and simmer for 20 minutes, or until the rice is cooked and the liquid is absorbed.",
    "Fluff the pilaf with a fork and garnish with chopped almonds.",
    "Serve hot and enjoy."
