{
  "title": "Quenched Turkish Lamb Kofte",
  "description": "A flavorful and moist lamb kofte dish with a hint of red wine and herbs, perfect for special occasions.",
  "cuisine": "Turkish",
  "diet": [
    "gluten-free",
