      "name": "ground lamb",
      "amount": "500g"
    },
    {
      "name": "red wine",
      "amount": "120ml"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "finely chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "parsley",
      "amount": "2 tbsp",
      "notes": "chopped"
    },
    {
      "name": "mint",
      "amount": "1 tsp",
      "notes": "chopped"
    },
    {
      "name": "allspice",
      "amount": "1 tsp"
    },
    {
      "name": "salt",
      "amount": "1 tsp"
    },
    {
      "name": "black pepper",
      "amount": "0.5 tsp"
    },
    {
      "name": "beaten egg",
      "amount": "1",
      "notes": "for binding"
    },
    {
      "name": "mantecare",
      "amount": "50g",
      "notes": "for emulsification"
    }
  ],
  "instructions": [
    "In a large bowl, combine the lamb, red wine, onion, garlic, parsley, mint, allspice, salt, and black pepper. Mix well with your hands until just combined.",
    "Stir in the beaten egg and mantecare until the mixture is evenly distributed.",
    "Cover the bowl with plastic wrap and refrigerate for at least 30 minutes to allow the flavors to meld.",
    "Preheat a grill or grill pan to medium-high heat.",
    "Using your hands, shape the lamb mixture into small kofte, about 5-6 cm in diameter.",
    "Place the kofte on the grill and cook for 4-5 minutes per side, or until they are cooked through and slightly charred.",
    "Transfer the kofte to a serving plate and garnish with additional parsley if desired.",
    "Serve immediately and enjoy!"
  ],
