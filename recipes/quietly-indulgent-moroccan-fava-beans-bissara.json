      "name": "dried fava beans",
      "amount": "1 cup",
      "notes": "soaked overnight and drained"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ground cumin",
      "amount": "1 teaspoon"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "star anise",
      "amount": "1 whole"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "water",
      "amount": "4 cups"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large pot over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the minced garlic and cook for an additional minute.",
    "Stir in the ground cumin, smoked paprika, and salt.",
    "Add the soaked and drained fava beans, whole star anise, and water to the pot.",
    "Bring the mixture to a boil, then reduce the heat to low and simmer for 30 minutes.",
    "Use an immersion blender to puree the bissara until smooth, or allow it to cool and puree it in a blender.",
    "Season the bissara with black pepper to taste.",
    "Serve the bissara hot, garnished with a sprinkle of smoked paprika if desired."
  ],
