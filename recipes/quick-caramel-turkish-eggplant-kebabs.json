  "ingredients": [
    {
      "name": "eggplant",
      "amount": "2 large",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "caramel sauce",
      "amount": "1/2 cup"
    },
    {
      "name": "pomegranate molasses",
      "amount": "2 tablespoons"
    },
    {
      "name": "sumac",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the grill to medium high heat.",
    "Thread the eggplant cubes onto skewers.",
    "Brush the eggplant with olive oil and season with salt, black pepper, and sumac.",
    "Grill the eggplant for 10 minutes, turning occasionally.",
    "In a small bowl, whisk together the caramel sauce and pomegranate molasses.",
    "Brush the caramel glaze onto the eggplant during the last 2 minutes of grilling.",
    "Remove the eggplant from the grill and sprinkle with parsley.",
    "Serve the kebabs hot, garnished with additional parsley if desired."
  ],
