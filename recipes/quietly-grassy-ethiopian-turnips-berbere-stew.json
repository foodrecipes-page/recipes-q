      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "vegetable oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "water",
      "amount": "4 cups"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    }
  ],
  "instructions": [
    "Heat the oil in a large tagliere over medium heat.",
    "Add the onion and cook until softened, about 5 minutes.",
    "Add the garlic and ginger and cook for 1 minute.",
    "Add the turnips and cook for 5 minutes, stirring occasionally.",
    "Add the berbere spice and cook for 1 minute.",
    "Add the water and bring to a boil.",
    "Reduce the heat to low and simmer, covered, for 20 minutes.",
    "Season with salt to taste.",
    "Serve hot, garnished with chopped fresh herbs if desired."
  ],
