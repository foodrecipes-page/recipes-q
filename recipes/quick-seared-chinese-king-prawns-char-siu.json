      "amount": "1 clove",
      "notes": "minced"
    },
    {
      "name": "green onions",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "sesame oil",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat a hot stone plate over high heat for 5 minutes.",
    "In a small bowl, whisk together Char Siu sauce, coconut oil, ginger, garlic, sesame oil, salt, and black pepper.",
    "Add the king prawns to the bowl and toss to coat with the Char Siu sauce mixture.",
    "Place the coated king prawns on the preheated hot stone plate and sear for 2-3 minutes per side.",
    "Remove the prawns from the heat and garnish with chopped green onions.",
    "Serve immediately on the hot stone plate.",
    "Caution: the hot stone plate will be extremely hot, use oven mitts or tongs to handle.",
    "Let the prawns rest for 1 minute before serving."
  ],
