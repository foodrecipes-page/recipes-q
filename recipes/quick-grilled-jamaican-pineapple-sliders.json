{
  "title": "Quick Grilled Jamaican Pineapple Sliders",
  "description": "A light and sweet Jamaican-inspired dish featuring juicy pineapple and crispy bacon. Perfect for a quick date-night dinner.",
  "cuisine": "jamaican",
