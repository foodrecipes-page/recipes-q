      "amount": "1/4 teaspoon"
    },
    {
      "name": "vegetable oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "scallions",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "bean sprouts",
      "amount": "1 cup"
    }
  ],
  "instructions": [
    "Heat the vegetable oil in a large pan over medium heat.",
    "Add the chopped scallions and cook until softened, about 2 minutes.",
    "Add the crab meat, tomato paste, fish sauce, and lime juice, and stir well.",
    "Bring the mixture to a simmer and cook for 5 minutes, stirring occasionally.",
    "Add the chopped peanuts, salt, and black pepper, and stir well.",
    "Slice the pita bread in half and toast until lightly browned.",
    "Assemble the bun-rieu by spooning the crab meat mixture over the toasted pita bread.",
    "Top with bean sprouts and serve immediately.",
    "Garnish with additional chopped scallions and peanuts, if desired."
  ],
