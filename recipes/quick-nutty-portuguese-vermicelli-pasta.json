      "amount": "1/4 tsp"
    },
    {
      "name": "chicken broth",
      "amount": "2 cups"
    }
  ],
  "instructions": [
    "Heat the olive oil in the tajine clay vessel over medium heat.",
    "Add the chopped almonds and cook for 2 minutes, stirring frequently.",
    "Add the grated ginger, garlic powder, salt, and black pepper, and cook for 1 minute.",
    "Add the vermicelli pasta and stir to combine with the almond mixture.",
    "Pour in the chicken broth and bring to a boil.",
    "Reduce the heat to low, cover the vessel, and simmer for 10 minutes.",
    "Remove the vessel from the heat and let it stand for 2 minutes.",
    "Fluff the pasta with a fork and serve hot."
  ],
