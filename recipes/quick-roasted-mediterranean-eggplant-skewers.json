{
  "title": "Quick Roasted Mediterranean Eggplant Skewers",
  "description": "A pungent and juicy Mediterranean dish featuring grana padano and lacquer glaze, perfect for a vegan friendly meal",
  "cuisine": "Mediterranean",
  "diet": [
    "vegan"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "eggplant",
      "amount": "2 medium",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "grana padano",
      "amount": "1/2 cup",
      "notes": "crumbled"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "oregano",
      "amount": "1 teaspoon",
      "notes": "dried"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "lacquer glaze",
      "amount": "1/4 cup"
    }
  ],
  "instructions": [
    "Preheat the oven to 425 degrees Fahrenheit",
    "Thread the eggplant cubes onto skewers",
    "In a bowl, whisk together olive oil, lemon juice, garlic, oregano, salt, and pepper",
    "Brush the mixture onto the eggplant skewers",
    "Place the skewers on a comal or baking sheet lined with parchment paper",
    "Roast in the oven for 20 minutes, or until the eggplant is tender",
    "Remove from the oven and brush with lacquer glaze",
    "Sprinkle with crumbled grana padano",
    "Serve hot"
  ],
