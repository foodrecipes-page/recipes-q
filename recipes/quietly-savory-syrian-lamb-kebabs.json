    {
      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "white wine",
      "amount": "1/2 cup"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "cumin",
      "amount": "2 teaspoons"
    },
    {
      "name": "coriander",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "paprika",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the grill to medium-high heat.",
    "In a large bowl, whisk together white wine, olive oil, garlic, onion, cumin, coriander, salt, black pepper, and paprika.",
    "Add the lamb cubes to the bowl and toss to coat with the marinade.",
    "Thread the marinated lamb cubes onto skewers, leaving a small space between each piece.",
    "Grill the kebabs for 8-10 minutes per side, or until they reach an internal temperature of 145 degrees.",
    "Let the kebabs rest for 5 minutes before serving.",
    "Serve the kebabs hot, garnished with fresh parsley or cilantro if desired."
  ],
