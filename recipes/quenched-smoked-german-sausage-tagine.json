  "instructions": [
    "heat the olive oil in the tagine over medium heat.",
    "add the onion, garlic, and ginger, and cook until the onion is translucent.",
    "add the smoked sausage and cook until browned.",
    "add the taco shells and cook for 2-3 minutes, until crispy.",
    "add the cumin, coriander, smoked paprika, salt, and black pepper, and stir to combine.",
    "add the lemon juice and stir to combine.",
    "bring the mixture to a simmer and cook for 10-15 minutes, or until the flavors have melded together.",
