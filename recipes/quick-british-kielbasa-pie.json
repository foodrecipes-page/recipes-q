{
  "title": "Quick British Kielbasa Pie",
  "description": "A buttery, flaky pie stuffed with sliced kielbasa, onions, and creamy potatoes for a cozy British comfort food.",
  "cuisine": "British",
  "diet": null,
  "meal": "dinner",
  "ingredients": [
    {
      "name": "puff pastry",
      "amount": "1/2 sheet",
      "notes": "cut into 4 strips"
    },
    {
      "name": "kielbasa",
      "amount": "100g",
      "notes": "sliced 1 cm thick"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "diced"
    },
    {
      "name": "potato",
      "amount": "1/4 cup",
      "notes": "diced and cooked"
    },
    {
      "name": "cheddar cheese",
      "amount": "1/4 cup",
      "notes": "shredded"
    },
    {
      "name": "mustard",
      "amount": "1 tsp",
      "notes": "mixed in"
    },
    {
      "name": "egg",
      "amount": "1",
      "notes": "beaten for glaze"
    },
    {
      "name": "salt",
      "amount": "to taste"
    },
    {
      "name": "black pepper",
      "amount": "to taste"
    }
  ],
  "instructions": [
    "Preheat oven to 200°C.",
    "Cut puff pastry into 4 strips and roll each into long cylinders.",
    "Slice kielbasa into 1 cm thick rounds.",
    "Sauté onions until translucent, then add sliced kielbasa and cook until lightly browned.",
    "Stir in diced potatoes and cook for 5 minutes, then remove from heat.",
    "Layer each pastry cylinder with the kielbasa mixture and sprinkle with shredded cheese.",
    "Roll up the pastry around the filling and seal the edges with beaten egg.",
    "Brush the tops with more beaten egg for a golden crust.",
    "Bake on a parchment-lined sheet for 18 minutes or until pastry is puffed and golden.",
    "Let cool for 5 minutes before slicing and serving."
  ],
