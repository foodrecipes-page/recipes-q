  "ingredients": [
    {
      "name": "morcilla",
      "amount": "1 pound",
      "notes": "Spanish blood sausage"
    },
    {
      "name": "vegetable oil",
      "amount": "1/4 cup"
    },
    {
      "name": "shallots",
      "amount": "1/2 cup",
      "notes": "finely chopped"
    },
    {
      "name": "chilies",
      "amount": "2",
      "notes": "seeded and chopped"
    },
    {
      "name": "fish sauce",
      "amount": "2 tablespoons"
    },
    {
      "name": "lime juice",
      "amount": "1 tablespoon"
    },
    {
      "name": "herbs",
      "amount": "1/4 cup",
      "notes": "such as cilantro or basil"
    },
    {
      "name": "banana leaves",
      "amount": "4",
      "notes": "for serving"
    }
  ],
  "instructions": [
    "Heat the vegetable oil in a large skillet over medium high heat",
    "Add the chopped shallots and cook until they are translucent",
    "Add the chopped chilies and cook for another minute",
    "Add the morcilla and cook until it is crispy and golden brown",
    "In a small bowl, whisk together the fish sauce and lime juice",
    "Pour the fish sauce mixture over the morcilla and stir to combine",
    "Stir in the chopped herbs",
    "Spoon the morcilla mixture onto a banana leaf and serve immediately"
  ],
