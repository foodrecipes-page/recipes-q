{
  "title": "Quick Crispy Thai Morcilla Larb",
  "description": "Spicy crispy Thai dish featuring morcilla, served in a banana leaf vessel, this low glycemic friendly meal is perfect for a romantic dinner",
  "cuisine": "Thai",
  "diet": [
    "low-glycemic",
    "gluten-free"
