    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon",
      "notes": "freshly ground"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "In a large skillet, heat the olive oil over medium-high heat.",
    "Add the chopped onion and cook until browned, about 5 minutes.",
    "Add the ground beef and cook until browned, breaking it up into small pieces as it cooks.",
    "Add the chopped carrots and potatoes, and cook for an additional 5 minutes.",
    "In a small bowl, whisk together the white wine, beef broth, and tomato paste.",
    "Pour the wine mixture over the meat and vegetables, and stir to combine.",
    "Season with salt and black pepper to taste.",
    "Transfer the mixture to 6 ramekins and roast in the preheated oven for 20 minutes.",
    "Serve hot and enjoy."
  ],
