    {
      "name": "tinned tomatoes",
      "amount": "2 cups",
      "notes": "drained and chopped"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "namul",
      "amount": "1 cup",
      "notes": "blanched and chopped"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "In a large paella pan, heat the olive oil over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the minced garlic and cook for an additional minute.",
    "Stir in the smoked paprika, salt, and black pepper.",
    "Add the chopped tinned tomatoes and cook for 2 minutes.",
    "Add the blanched and chopped namul and stir to combine.",
    "Transfer the paella pan to the preheated oven and roast for 15 minutes.",
    "Remove the pan from the oven and stir in the lemon juice.",
    "Form the mixture into anticuchos and serve hot."
  ],
