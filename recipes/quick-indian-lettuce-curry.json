{
  "title": "Quick Indian Lettuce Curry",
  "description": "A sweet and comforting Tamil dish featuring lettuce and bonito flakes, perfect for a sick day. This recipe is gluten-free friendly and can be made in a Dutch oven.",
  "cuisine": "Indian",
  "diet": [
    "gluten-free"
  ],
