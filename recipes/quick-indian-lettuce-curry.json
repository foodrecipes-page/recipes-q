  "ingredients": [
    {
      "name": "lettuce",
      "amount": "2 heads",
      "notes": "chopped"
    },
    {
      "name": "bonito flakes",
      "amount": "1/4 cup"
    },
    {
      "name": "coconut oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "curry powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "water",
      "amount": "1 cup"
    }
  ],
  "instructions": [
    "Heat the coconut oil in a Dutch oven over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and grated ginger and cook for 1 minute.",
    "Add the curry powder, salt, and black pepper and cook for 1 minute.",
    "Add the chopped lettuce and cook until it is wilted.",
    "Add the bonito flakes and water and stir well.",
    "Bring the mixture to a simmer and cook for 10 minutes.",
    "Reduce the heat to low and cook for an additional 5 minutes.",
    "Serve hot and enjoy."
  ],
