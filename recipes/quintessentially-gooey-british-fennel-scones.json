      "name": "fennel bulb",
      "amount": "2 medium",
      "notes": "chopped"
    },
    {
      "name": "self-raising flour",
      "amount": "1 1/2 cups"
    },
    {
      "name": "butter",
      "amount": "1/2 cup",
      "notes": "melted"
    },
    {
      "name": "grated cheddar cheese",
      "amount": "1 cup"
    },
    {
      "name": "diced onion",
      "amount": "1 medium"
    },
    {
      "name": "minced garlic",
      "amount": "2 cloves"
    },
    {
      "name": "diced fresh chili",
      "amount": "1 medium"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the pressure cooker to 15 psi.",
    "In a large bowl, whisk together the flour, salt, and black pepper.",
    "Add the melted butter, grated cheese, chopped fennel, diced onion, minced garlic, and diced chili to the bowl and mix until a dough forms.",
    "Turn the dough out onto a floured surface and knead for 5 minutes.",
    "Shape the dough into small scones and place them in the agave leaf vessel.",
    "Pressure-cook the scones for 10 minutes.",
    "Allow the pressure to release naturally for 5 minutes.",
    "Serve the scones warm, straight from the agave leaf vessel."
  ],
