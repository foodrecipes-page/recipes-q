{
  "title": "Quietly Quenched Thai Saskatoon Berry Curry",
  "description": "A cultured and creamy Thai dish featuring saskatoon berries and nuka-pickle, perfect for a romantic dinner",
  "cuisine": "Thai",
  "diet": [
    "Whole30",
    "Gluten-free"
  ],
