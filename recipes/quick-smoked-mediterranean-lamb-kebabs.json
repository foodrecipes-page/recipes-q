  "ingredients": [
    {
      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "Italian seasoning",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Preheat grill to medium-high heat",
    "In a large bowl, whisk together olive oil, Italian seasoning, garlic powder, smoked paprika, salt, and black pepper",
    "Add the lamb cubes to the bowl and toss to coat with the marinade",
    "Thread the lamb cubes onto skewers, leaving a small space between each piece",
    "Grill the kebabs for 8-10 minutes, turning occasionally, until cooked to an internal temperature of 145 degrees",
    "Brush the kebabs with lemon juice during the last minute of grilling",
    "Let the kebabs rest for 5 minutes before serving",
    "Serve hot and enjoy"
  ],
