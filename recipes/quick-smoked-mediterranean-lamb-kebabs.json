{
  "title": "Quick Smoked Mediterranean Lamb Kebabs",
  "description": "A flavorful and crispy Mediterranean dish featuring lamb kebabs with Italian seasoning, perfect for a quick dinner",
  "cuisine": "Mediterranean",
  "diet": [
    "gluten-free",
