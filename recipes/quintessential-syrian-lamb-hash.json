{
  "title": "Quintessential Syrian Lamb Hash",
  "description": "A savory Syrian dish featuring lamb, almond butter, and cheese, perfect for a hangover cure, made in a wok and paleo-friendly.",
  "cuisine": "Syrian",
  "diet": [
    "paleo"
  ],
