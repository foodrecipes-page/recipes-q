      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "cut into small pieces"
    },
    {
      "name": "almond butter",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "sumac",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "halloumi cheese",
      "amount": "1/2 cup",
      "notes": "crumbled"
    }
  ],
  "instructions": [
    "Heat 2 tablespoons of oil in a wok over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the lamb pieces and cook until they are browned.",
    "Add the sumac, salt, and black pepper, and stir to combine.",
    "Add the almond butter and stir to combine.",
    "Add the crumbled halloumi cheese and stir until it is melted and well combined.",
    "Reduce heat to low and simmer for 10 minutes.",
    "Serve hot, garnished with chopped fresh parsley."
  ],
