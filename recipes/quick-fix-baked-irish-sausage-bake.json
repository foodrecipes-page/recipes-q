{
  "title": "Quick-Fix Baked Irish Sausage Bake",
  "description": "A yeasty, pillowy, quick-fix Irish dish featuring ssamjang, perfect for a weeknight meal in a bento box.",
  "cuisine": "irish",
  "diet": [
    "fodmap-friendly"
  ],
