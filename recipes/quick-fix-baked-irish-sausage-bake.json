  "ingredients": [
    {
      "name": "Irish sausages",
      "amount": "6"
    },
    {
      "name": "all-purpose flour",
      "amount": "1/2 cup"
    },
    {
      "name": "ssamjang",
      "amount": "2 tbsp"
    },
    {
      "name": "butter",
      "amount": "2 tbsp"
    },
    {
      "name": "milk",
      "amount": "1 cup"
    },
    {
      "name": "large egg",
      "amount": "1"
    },
    {
      "name": "cheddar cheese",
      "amount": "1 cup, shredded"
    }
  ],
  "instructions": [
    "Preheat oven to 375°F (190°C).",
    "In a large bowl, combine flour, egg, and milk. Mix well.",
    "Add shredded cheddar cheese and mix until combined.",
    "Cut the Irish sausages in half lengthwise.",
    "Place the sausages in a greased 9x13-inch baking dish.",
    "Pour the flour mixture over the sausages.",
    "Drizzle the ssamjang over the top. ",
    "Dot the top with butter.",
    "Bake for 25 minutes, then broil for 5 minutes or until golden brown.",
    "Let it rest for 5 minutes before serving."
  ],
