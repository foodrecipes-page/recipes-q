{
  "title": "Quenched Ukrainian Citrus Casserole",
  "description": "A warm, citrusy, and cozy Ukrainian dish featuring ginger cordial, beurre-monte, and a crumbly texture.",
  "cuisine": "ukrainian",
  "diet": [
    "kosher"
  ],
  "meal": "breakfast",
  "ingredients": [
    {
      "name": "all-purpose flour",
      "amount": "1 3/4 cups",
      "notes": ""
    },
    {
      "name": "granulated sugar",
      "amount": "1/2 cup",
      "notes": ""
    },
    {
      "name": "unsalted butter, melted",
