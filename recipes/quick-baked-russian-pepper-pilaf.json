{
  "title": "Quick Baked Russian Pepper Pilaf",
  "description": "A simple, anti-inflammatory-friendly Russian dish featuring yellow pepper, prepared quickly with a bamboo tray.",
  "cuisine": "Russian",
  "diet": [
    "vegetarian",
    "gluten-free",
    "low-sodium"
  ],
