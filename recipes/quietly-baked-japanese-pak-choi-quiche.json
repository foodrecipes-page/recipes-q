  "ingredients": [
    {
      "name": "pak choi",
      "amount": "1 bunch",
      "notes": "chopped"
    },
    {
      "name": "pie crust",
      "amount": "1 sheet",
      "notes": "thawed"
    },
    {
      "name": "eggs",
      "amount": "4 large",
      "notes": "beaten"
    },
    {
      "name": "milk",
      "amount": "1 cup",
      "notes": "whole"
    },
    {
      "name": "grated cheese",
      "amount": "1 cup",
      "notes": "monterey jack"
    },
    {
      "name": "soy sauce",
      "amount": "2 tablespoons",
      "notes": "low sodium"
    },
    {
      "name": "sesame oil",
      "amount": "1 teaspoon",
      "notes": "toasted"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon",
      "notes": "kosher"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit",
    "Roll out the pie crust and place it in a tart pan",
    "In a large bowl, whisk together the eggs, milk, grated cheese, soy sauce, sesame oil, and salt",
    "Add the chopped pak choi to the bowl and stir to combine",
    "Pour the egg mixture into the pie crust",
    "Bake the quiche for 35 minutes or until the edges are golden brown",
    "Remove the quiche from the oven and let it cool for 10 minutes",
    "Slice the quiche into wedges and serve",
    "Garnish with additional pak choi if desired"
  ],
