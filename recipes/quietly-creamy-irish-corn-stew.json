      "amount": "1 can",
      "notes": "14.75 oz"
    },
    {
      "name": "potatoes",
      "amount": "2 medium",
      "notes": "peeled and diced"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and sliced"
    },
    {
      "name": "celery",
      "amount": "2 stalks",
      "notes": "sliced"
    },
    {
      "name": "all purpose flour",
      "amount": "2 tbsp"
    },
    {
      "name": "butter",
      "amount": "2 tbsp"
    },
    {
      "name": "milk",
      "amount": "1 cup"
    },
    {
      "name": "salt",
      "amount": "1 tsp"
    },
    {
      "name": "pepper",
      "amount": "1/2 tsp"
    },
    {
      "name": "parsley",
      "amount": "1/4 cup",
      "notes": "chopped fresh"
    }
  ],
  "instructions": [
    "In a large pot, melt the butter over medium heat.",
    "Add the sliced celery and cook until it is tender, about 5 minutes.",
    "Add the diced potatoes and sliced carrots, cook for an additional 5 minutes.",
    "Sprinkle the flour over the vegetables and cook for 1 minute.",
    "Gradually stir in the milk and bring the mixture to a simmer.",
    "Reduce the heat to low and let it cook for 10 minutes or until the vegetables are tender.",
    "Stir in the cream corn, salt, and pepper, and let it heat through.",
    "Taste and adjust the seasoning as needed.",
    "Ladle the stew into mason jars and top with chopped parsley.",
    "Serve hot and enjoy."
  ],
