      "amount": "400 g",
      "notes": "canned, drained and rinsed"
    },
    {
      "name": "Chickpea flour",
      "amount": "2 tbsp",
      "notes": "for binding"
    },
    {
      "name": "All-purpose flour",
      "amount": "1 tbsp",
      "notes": "for texture"
    },
    {
      "name": "Speculaas spice mix",
      "amount": "1 tsp",
      "notes": "adds warmth"
    },
    {
      "name": "Dried oregano",
      "amount": "1 tsp"
    },
    {
      "name": "Dried thyme",
      "amount": "1 tsp"
    },
    {
      "name": "Fresh dill",
      "amount": "1 tbsp",
      "notes": "chopped"
    },
    {
      "name": "Lemon juice",
      "amount": "1 tbsp"
    },
    {
      "name": "Olive oil",
      "amount": "1 tbsp",
      "notes": "for frying"
    },
    {
      "name": "Salt",
      "amount": "1 tsp"
    },
    {
      "name": "Black pepper",
      "amount": "1/2 tsp"
    }
  ],
  "instructions": [
    "Drain and rinse chickpeas, then roughly mash them in a bowl.",
    "Add chickpea flour, all-purpose flour, speculaas spice mix, oregano, thyme, dill, lemon juice, salt, pepper, and mix until dough forms.",
    "Heat a non-stick skillet over medium heat and add 1 tbsp olive oil.",
    "Scoop spoonfuls of batter and shape into small patties, pressing them flat.",
    "Fry the fritters for 3-4 minutes on each side until golden brown and crispy.",
    "Transfer fritters to a paper towel-lined plate to drain excess oil.",
    "Serve warm with a squeeze of fresh lemon or a drizzle of yogurt if desired.",
    "Enjoy as a quick, post-workout snack."
  ],
