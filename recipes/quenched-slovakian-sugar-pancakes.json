{
  "title": "Quenched Slovakian Sugar Pancakes",
  "description": "Tangy and aerated Slovakian pancakes perfect for a romantic breakfast or dessert.",
  "cuisine": "Slovakian",
  "diet": null,
  "meal": "dessert",
  "ingredients": [
    {
      "name": "all-purpose flour",
      "amount": "2 cups",
      "notes": "sifted"
    },
    {
      "name": "sugar",
      "amount": "1 cup",
      "notes": "granulated"
    },
    {
      "name": "large egg",
      "amount": "1",
      "notes": ""
    },
    {
      "name": "milk",
      "amount": "1 cup",
      "notes": "whole milk"
    },
    {
      "name": "butter, melted",
      "amount": "2 tablespoons",
      "notes": ""
    },
    {
      "name": "Namul-blanch-season",
      "amount": "1/2 teaspoon",
      "notes": ""
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon",
      "notes": ""
    }
  ],
  "instructions": [
    "Whisk together flour, sugar, and Namul-blanch-season in a medium bowl",
    "Add egg, milk, and melted butter to the bowl and mix until a smooth batter forms",
    "Let the batter rest for 10 minutes",
    "Heat a non-stick skillet or griddle over medium heat",
    "Drop the batter by 1/4 cupfuls onto the skillet and cook for 2-3 minutes, until bubbles appear on the surface",
    "Flip the pancakes and cook for an additional 1-2 minutes",
    "Transfer the pancakes to a wire rack to cool",
    "Drizzle with a tangy quencher sauce (made by mixing equal parts sour cream and sugar)"
  ],
