{
  "title": "Quietly Baked Thai Chicken Skewers",
  "description": "A high-protein dish featuring lemongrass and salt-bake flavors, perfect for a date night, with a grassy and aerated texture.",
  "cuisine": "Thai",
  "diet": [
    "gluten-free",
    "low-carb"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "chicken breast",
      "amount": "1 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "lemongrass",
      "amount": "2 stalks",
      "notes": "bruised"
    },
    {
      "name": "coconut milk",
      "amount": "1/2 cup"
    },
    {
      "name": "fish sauce",
      "amount": "2 tablespoons"
    },
    {
      "name": "lime juice",
      "amount": "1 tablespoon"
    },
    {
      "name": "brown sugar",
      "amount": "1 tablespoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "bamboo skewers",
      "amount": "10-12",
      "notes": "soaked in water"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "In a blender, combine lemongrass, coconut milk, fish sauce, lime juice, brown sugar, salt, and black pepper, and blend until smooth.",
    "Thread the chicken pieces onto the bamboo skewers.",
    "Brush the lemongrass mixture onto the chicken skewers.",
    "Place the skewers on a baking sheet lined with parchment paper.",
    "Bake for 20-25 minutes, or until the chicken is cooked through.",
    "Serve hot, garnished with fresh cilantro and lime wedges.",
    "Let the skewers rest for 5 minutes before serving.",
    "Serve with steamed vegetables or a side salad."
  ],
