{
  "title": "Quick Smoked Canadian Chicken Wings Skewers",
  "description": "A low-calorie, post-workout Canadian dish featuring smoked chicken wings, perfect for a quick and healthy snack.",
  "cuisine": "Canadian",
  "diet": [
    "low-calorie",
    "high-protein"
  ],
