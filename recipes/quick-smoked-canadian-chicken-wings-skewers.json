  "ingredients": [
    {
      "name": "chicken wings",
      "amount": "1 pound",
      "notes": "bone-in, skin-on"
    },
    {
      "name": "smoke flavoring",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "garlic powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "lemon juice",
      "amount": "1 tablespoon"
    }
  ],
  "instructions": [
    "Preheat grill to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together smoke flavoring, olive oil, garlic powder, paprika, salt, and black pepper.",
    "Add the chicken wings to the bowl and toss to coat evenly.",
    "Thread the chicken wings onto skewers, leaving a small space between each wing.",
    "Grill the skewers for 20-25 minutes, or until the chicken is cooked through.",
    "Brush the chicken with lemon juice during the last 5 minutes of cooking.",
    "Remove the skewers from the grill and let rest for 5 minutes.",
    "Serve hot and enjoy."
  ],
