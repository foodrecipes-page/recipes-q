  "title": "Quick Crisp Post-Workout Australian Nut Skillet",
  "description": "A crispy and nutty Australian-inspired dish perfect for post-workout fuel.",
  "cuisine": "australian",
  "diet": [],
  "meal": "snack",
  "ingredients": [
    {
      "name": "Australian bush nuts (peeled and chopped)",
      "amount": "1 cup",
      "notes": ""
    },
    {
      "name": "Coconut oil",
      "amount": "2 tablespoons",
      "notes": ""
    },
    {
      "name": "Medium sweet potato (peeled and diced)",
      "amount": "1 medium",
      "notes": ""
    },
    {
      "name": "Bhuna spices (store-bought or homemade)",
      "amount": "1 teaspoon",
      "notes": ""
    },
    {
      "name": "Caramel sauce (low-sodium, store-bought or homemade)",
      "amount": "1/4 cup",
      "notes": ""
    },
    {
      "name": "Greek yogurt",
      "amount": "1/2 cup",
      "notes": ""
    },
    {
      "name": "Fresh mint leaves",
      "amount": "1/4 cup",
      "notes": "chopped (optional)"
    }
  ],
  "instructions": [
    "Heat coconut oil in a large wok over medium heat. ",
    "Add the chopped Australian bush nuts and cook for 2 minutes or until fragrant.",
    "Add the diced sweet potato and cook for 4-5 minutes or until slightly tender.",
    "Sprinkle bhuna spices over the sweet potato and cook for 1 minute.",
    "Pour the low-sodium caramel sauce over the sweet potato and stir to coat.",
    "Reduce heat to low and simmer for 2-3 minutes or until the sauce has thickened.",
    "Stir in the Greek yogurt until smooth and creamy.",
    "Garnish with chopped fresh mint leaves if desired.",
    "Serve the skillet hot and enjoy!"
  ],
