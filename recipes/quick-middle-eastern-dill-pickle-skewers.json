      "name": "dill pickles",
      "amount": "1 cup",
      "notes": "sliced into 1/4 inch thick rounds"
    },
    {
      "name": "infused oil",
      "amount": "1/4 cup",
      "notes": "with garlic and chili flakes"
    },
    {
      "name": "agave leaves",
      "amount": "12",
      "notes": "fresh or dried"
    },
    {
      "name": "pita bread",
      "amount": "1 cup",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "cherry tomatoes",
      "amount": "1 cup",
      "notes": "halved"
    },
    {
      "name": "cucumber",
      "amount": "1 cup",
      "notes": "sliced into 1/4 inch thick rounds"
    },
    {
      "name": "red onion",
      "amount": "1/2 cup",
      "notes": "thinly sliced"
    },
    {
      "name": "sumac",
      "amount": "1 tablespoon",
      "notes": "ground"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "Thread a dill pickle slice, a cherry tomato half, a cucumber slice, and a red onion slice onto each agave leaf.",
    "Drizzle the infused oil over the skewers.",
    "Sprinkle the sumac and pita bread cubes over the skewers.",
    "Season with salt to taste.",
    "Serve immediately and enjoy.",
    "Garnish with additional sumac and pita bread cubes if desired.",
    "Store any leftovers in an airtight container in the refrigerator for up to 24 hours.",
    "Note: this recipe is for refrigerator pickling/preserving only — store in the refrigerator and consume within 1 week. Do not water-bath can without an acid (vinegar or lemon juice)."
