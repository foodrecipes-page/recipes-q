{
  "title": "Quenched Mexican Liver Tacos",
  "description": "Tender chicken liver shaped like nigiri, slow‑cooked with Mexican spices and served on warm corn tortillas for a paleo‑friendly carnitas style taco.",
  "cuisine": "mexican",
  "diet": [
    "paleo"
  ],
