{
  "title": "Quick Fragrant Moroccan Chicken Briouat",
  "description": "Fresh and crumbly Moroccan dish featuring cilantro leaves, perfect for a romantic dinner, this recipe is onion and garlic free.",
  "cuisine": "Moroccan",
  "diet": [
    "gluten free",
    "low carb"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "boneless chicken breast",
      "amount": "1 pound",
      "notes": "cut into small pieces"
    },
    {
      "name": "cilantro leaves",
      "amount": "1 cup",
      "notes": "chopped"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "filo dough",
      "amount": "1 package",
      "notes": "thawed"
    },
    {
      "name": "water",
      "amount": "1 cup"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large bowl, whisk together olive oil, lemon juice, paprika, salt, and black pepper.",
    "Add the chopped cilantro leaves and chicken pieces to the bowl and mix well.",
    "Lay a sheet of filo dough on a flat surface and brush with water.",
    "Place a tablespoon of the chicken mixture in the center of the filo dough.",
    "Fold the filo dough into a triangle and press the edges to seal.",
    "Repeat the process with the remaining ingredients.",
    "Place the briouats on a baking sheet lined with parchment paper.",
    "Bake for 25 minutes or until the filo dough is golden brown.",
    "Serve hot and enjoy."
  ],
