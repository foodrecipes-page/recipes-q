      "name": "Smoked duck breast",
      "amount": "1 1/2 pounds",
      "notes": "Smoked for 30 minutes before adding to stew"
    },
    {
      "name": "Green chilli",
      "amount": "2",
      "notes": "Fresh and seeded"
    },
    {
      "name": "Onion",
      "amount": "1 large",
      "notes": "Chopped"
    },
    {
      "name": "Garlic",
      "amount": "3 cloves",
      "notes": "Minced"
    },
    {
      "name": "Potatoes",
      "amount": "4 large",
      "notes": "Peel and chop"
    },
    {
      "name": "Caraway seeds",
      "amount": "1 teaspoon",
      "notes": "Whole"
    },
    {
