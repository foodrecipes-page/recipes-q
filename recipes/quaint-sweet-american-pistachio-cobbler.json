{
  "title": "Quaint Sweet American Pistachio Cobbler",
  "description": "A sweet and comforting American dessert featuring ground pistachios and ferment-kimchi, perfect for a plant-based friendly treat.",
  "cuisine": "American",
  "diet": [
    "plant-based",
    "vegetarian"
  ],
  "meal": "dessert",
  "ingredients": [
    {
      "name": "ground pistachios",
      "amount": "1 cup",
      "notes": "freshly ground"
    },
    {
      "name": "ferment-kimchi",
      "amount": "1/2 cup",
      "notes": "homemade or store-bought"
    },
    {
      "name": "all-purpose flour",
      "amount": "2 cups"
    },
    {
      "name": "granulated sugar",
      "amount": "1 cup"
    },
    {
      "name": "non-dairy milk",
      "amount": "1 cup"
    },
    {
      "name": "vegan butter",
      "amount": "1/2 cup",
      "notes": "melted"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "vanilla extract",
      "amount": "1 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large bowl, whisk together the flour, sugar, and salt.",
    "Add the non-dairy milk, melted vegan butter, and vanilla extract to the bowl and stir until just combined.",
    "Fold in the ground pistachios and ferment-kimchi.",
    "Pour the mixture into a 9x9 inch baking dish.",
    "Bake for 40 minutes or until the cobbler is golden brown and set.",
    "Remove from the oven and let cool for 10 minutes.",
    "Serve warm and enjoy."
  ],
