    {
      "name": "onions",
      "amount": "1 cup",
      "notes": "sliced"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
