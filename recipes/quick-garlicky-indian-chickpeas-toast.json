    },
    {
      "name": "lemon juice",
      "amount": "1 tablespoon",
      "notes": "for garnish"
    }
  ],
  "instructions": [
    "Heat ghee or oil in a pan over medium heat",
    "Add cumin seeds and let them sizzle for a few seconds",
    "Add minced garlic and grated ginger and saute for 1 minute",
    "Add chickpeas and saute for 2-3 minutes",
    "Season with salt to taste",
    "Toast whole wheat bread until crispy",
    "Spread the chickpea mixture over the toast",
    "Squeeze lemon juice over the top and serve",
    "Garnish with chopped cilantro or scallions if desired"
  ],
