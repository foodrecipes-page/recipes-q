      "notes": "chopped"
    },
    {
      "name": "rice",
      "amount": "2 cups",
      "notes": "preferably day-old rice"
    },
    {
      "name": "khao khuat",
      "amount": "1/2 cup",
      "notes": "fried and ground"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "cumin",
      "amount": "1 teaspoon",
      "notes": "ground"
    },
    {
      "name": "paprika",
      "amount": "1/2 teaspoon",
      "notes": "smoked"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon",
      "notes": "low-sodium"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon",
      "notes": "freshly ground"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large saucepan over medium heat.",
    "Add the chopped onion and cook until translucent, about 5 minutes.",
    "Add the minced garlic and cook for an additional minute, until fragrant.",
    "Add the chopped shungiku and cook until wilted, about 3 minutes.",
    "Add the ground cumin, smoked paprika, salt, and black pepper, and stir to combine.",
    "Add the fried and ground khao khuat and cooked rice to the saucepan, and stir to combine.",
    "Reduce heat to low and cook, covered, for 10 minutes, until the rice is heated through and fluffy.",
    "Fluff the pilaf with a fork and serve hot.",
    "Serve with a squeeze of fresh lemon juice, if desired."
  ],
