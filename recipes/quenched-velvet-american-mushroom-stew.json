{
  "title": "Quenched Velvet American Mushroom Stew",
  "description": "A savory, velvety stew bursting with chestnut mushroom and confit tomato, perfect for a paleo-friendly, energizing meal.",
  "cuisine": "American",
  "diet": [
    "paleo"
  ],
  "meal": "dinner",
