      "amount": "1 cup",
      "notes": "store-bought or homemade"
    },
    {
      "name": "extra virgin olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the grill to medium-high heat.",
    "Cut the red bell peppers into large chunks and thread them onto skewers.",
    "In a small bowl, whisk together the nuka-pickle, olive oil, lemon juice, garlic, salt, and black pepper.",
    "Brush the mixture onto the bell peppers.",
    "Grill the skewers for 10-12 minutes, turning occasionally.",
    "Serve the skewers hot, garnished with chopped fresh parsley.",
    "Let the skewers cool for a few minutes before serving.",
    "Serve with additional nuka-pickle on the side, if desired."
  ],
