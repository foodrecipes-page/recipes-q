  "ingredients": [
    {
      "name": "almond flour",
      "amount": "2 cups",
      "notes": "finely ground"
    },
    {
      "name": "coconut sugar",
      "amount": "1 cup"
    },
    {
      "name": "dark chocolate chips",
      "amount": "1 cup"
    },
    {
      "name": "coconut oil",
      "amount": "1/2 cup"
    },
    {
      "name": "eggs",
      "amount": "4 large"
    },
    {
      "name": "vanilla extract",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "cassava cookies",
      "amount": "1 package",
      "notes": "crushed"
    }
  ],
  "instructions": [
    "Preheat the oven to 350 degrees Fahrenheit.",
    "In a large bowl, mix together the almond flour, coconut sugar, and salt.",
    "Add the dark chocolate chips, coconut oil, eggs, and vanilla extract to the bowl and mix until well combined.",
    "Stir in the crushed cassava cookies.",
    "Pour the mixture into a 9x13 inch baking dish.",
    "Bake for 25 minutes or until the edges are lightly golden brown.",
    "Remove from the oven and let cool for 10 minutes.",
    "Cut into squares and serve warm."
  ],
