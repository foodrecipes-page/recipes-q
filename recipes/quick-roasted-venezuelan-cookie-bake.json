{
  "title": "Quick Roasted Venezuelan Cookie Bake",
  "description": "A rich and indulgent Venezuelan dessert featuring roasted cookies and a salt-bake crust, made with whole30-friendly ingredients.",
  "cuisine": "Venezuelan",
