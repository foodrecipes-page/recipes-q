{
  "title": "Quenched Kenyan Raisins Crumble",
  "description": "A sweet, crumbly dessert that blends smoky binchotan charcoal with raisins for a romantic Kenyan flavor, all while keeping it diabetic-friendly.",
  "cuisine": "Kenyan",
  "diet": [
    "diabetic-friendly",
    "low-carb"
  ],
  "meal": "dessert",
  "ingredients": [
    {
      "name": "raisins",
      "amount": "1 cup"
    },
    {
      "name": "activated charcoal powder",
      "amount": "1 tsp",
      "notes": "for smoky flavor"
    },
    {
      "name": "almond flour",
      "amount": "1/2 cup"
    },
    {
      "name": "rolled oats",
      "amount": "1/4 cup"
    },
    {
      "name": "coconut flour",
      "amount": "2 tbsp"
    },
    {
      "name": "unsweetened cocoa powder",
      "amount": "1 tbsp"
    },
    {
      "name": "melted coconut oil",
      "amount": "3 tbsp"
    },
    {
      "name": "stevia or erythritol",
      "amount": "2 tbsp"
    },
    {
      "name": "ground cinnamon",
      "amount": "1/2 tsp"
    },
    {
      "name": "salt",
      "amount": "pinch"
    },
    {
      "name": "vanilla extract",
      "amount": "1 tsp"
    }
  ],
  "instructions": [
    "Preheat oven to 350°F (175°C).",
    "Rinse and drain raisins, then toss them in activated charcoal powder until evenly coated.",
    "In a bowl combine almond flour, rolled oats, coconut flour, cocoa powder, cinnamon, and salt.",
    "Whisk melted coconut oil, stevia, and vanilla extract together, then pour into the dry mix and stir until crumbly.",
    "Fold in the charcoal‑coated raisins.",
    "Spread mixture evenly into a greased 8‑inch square baking pan.",
    "Bake for 18 minutes or until edges are golden.",
    "Remove and let cool for 5 minutes before cutting into squares.",
    "Serve warm or at room temperature."
  ],
