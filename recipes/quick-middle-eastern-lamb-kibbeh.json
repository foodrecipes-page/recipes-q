  "title": "Quick Middle Eastern Lamb Kibbeh",
  "description": "A funky, molten, quick-fix Middle Eastern dish featuring smoked paprika and ferment-jang, served in scallop shells.",
  "cuisine": "Middle Eastern",
  "diet": [
    "low-carb"
  ],
  "meal": "dinner",
  "ingredients": [
