      "name": "ground lamb",
      "amount": "1 pound",
      "notes": "80/20 lean to fat ratio"
    },
    {
      "name": "smoked paprika",
      "amount": "2 tablespoons"
    },
    {
      "name": "ferment-jang",
      "amount": "1 tablespoon"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "finely chopped"
    },
    {
      "name": "bulgur",
      "amount": "1/2 cup",
      "notes": "fine grind"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "scalloped shells",
      "amount": "12",
      "notes": "for serving"
    }
  ],
  "instructions": [
    "Preheat oven to 400 degrees.",
    "In a large bowl, combine ground lamb, smoked paprika, ferment-jang, onion, bulgur, salt, and black pepper.",
    "Mix well with your hands until just combined.",
    "Divide the mixture into 12 equal parts and shape each into a ball.",
    "Flatten each ball slightly into a disk shape.",
    "Place a disk into each scallop shell.",
    "Bake for 15 minutes or until the lamb is cooked through.",
    "Serve immediately in the scallop shells."
  ],
