  "ingredients": [
    {
      "name": "grape leaves",
      "amount": "20 leaves",
      "notes": "fresh or jarred"
    },
    {
      "name": "nduja",
      "amount": "1/2 cup"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "finely chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "tadka spice mix",
      "amount": "1 tablespoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    }
  ],
  "instructions": [
    "Rinse the grape leaves and remove the stems.",
    "In a large skillet, heat the olive oil over medium heat.",
    "Add the chopped onion and cook until translucent.",
    "Add the minced garlic and cook for 1 minute.",
    "Stir in the nduja, tadka spice mix, salt, and black pepper.",
    "Cook for 2 minutes, stirring constantly.",
    "Add the lemon juice and stir to combine.",
    "Lay a grape leaf flat and place 1 tablespoon of the nduja mixture in the center.",
    "Fold the stem end over the filling, then fold in the sides and roll the leaf into a neat package.",
    "Repeat with the remaining grape leaves and filling.",
    "Serve the dolma warm or at room temperature."
  ],
