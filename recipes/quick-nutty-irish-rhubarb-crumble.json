{
  "title": "Quick Nutty Irish Rhubarb Crumble",
  "description": "A light and creamy Irish dessert featuring forced rhubarb and a nutty crumble topping, made with whole30-friendly ingredients and no added sugar.",
  "cuisine": "Irish",
  "diet": [
    "whole30",
    "gluten-free"
  ],
  "meal": "dessert",
  "ingredients": [
    {
      "name": "forced rhubarb",
      "amount": "2 pounds",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "almond flour",
      "amount": "1 cup"
    },
    {
      "name": "chopped walnuts",
      "amount": "1/2 cup"
    },
    {
      "name": "coconut oil",
      "amount": "1/4 cup"
    },
    {
      "name": "eggs",
      "amount": "2"
    },
    {
      "name": "vanilla extract",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees.",
    "In a large bowl, mix together the rhubarb and vanilla extract.",
    "In a separate bowl, combine the almond flour, chopped walnuts, and salt.",
    "Add the coconut oil to the dry ingredients and mix until crumbly.",
    "Add the eggs to the dry ingredients and mix until a crumbly mixture forms.",
    "Pour the rhubarb mixture into a 9x9 inch baking dish.",
    "Top the rhubarb with the crumbly mixture.",
    "Bake for 35 minutes or until the topping is golden brown.",
    "Let cool for 10 minutes before serving."
  ],
