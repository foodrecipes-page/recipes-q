{
  "title": "Quietly Velvety Greek Ham Skillet",
  "description": "A comforting Greek dish featuring parma ham, render-fat, and low-carb friendly ingredients, cooked to perfection in a comal.",
  "cuisine": "Greek",
  "diet": [
    "low-carb",
    "gluten-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "parma ham",
      "amount": "6 slices",
      "notes": "diced"
    },
    {
      "name": "render-fat",
      "amount": "2 tablespoons"
    },
    {
      "name": "kalamata olives",
      "amount": "1 cup",
      "notes": "pitted"
    },
    {
      "name": "artichoke hearts",
      "amount": "1 can",
      "notes": "drained and chopped"
    },
    {
      "name": "feta cheese",
      "amount": "1/2 cup",
      "notes": "crumbled"
    },
    {
      "name": "spinach",
      "amount": "2 cups",
      "notes": "fresh"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "black pepper",
      "amount": "1 teaspoon"
    }
  ],
  "instructions": [
    "Heat the render-fat in a comal over medium heat.",
    "Add the diced parma ham and cook until lightly browned.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the kalamata olives, artichoke hearts, and feta cheese, and stir to combine.",
    "Add the fresh spinach and cook until wilted.",
    "Squeeze the lemon juice over the top and stir to combine.",
    "Season with black pepper to taste.",
    "Serve hot, straight from the comal."
  ],
