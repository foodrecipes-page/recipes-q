{
  "title": "Quick Molten Polish Ground Annatto Pilaf",
  "description": "A lacto-vegetarian friendly Polish dish featuring ground annatto, with a mustardy and molten flavor profile, perfect for satisfying midnight cravings.",
  "cuisine": "Polish",
  "diet": [
    "lacto-vegetarian"
  ],
