      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "red pepper paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "shio-koji cure",
      "amount": "1 teaspoon"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "potatoes",
      "amount": "2 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "vegetable broth",
      "amount": "4 cups"
    },
    {
      "name": "tomato paste",
      "amount": "1 tablespoon"
    },
    {
      "name": "dried thyme",
      "amount": "1 teaspoon"
    }
  ],
  "instructions": [
    "Heat oil in a large pot over medium heat.",
    "Add the lamb and cook until browned on all sides.",
    "Add the onion, carrots, and potatoes, and cook until the vegetables are tender.",
    "Add the red pepper paste, shio-koji cure, vegetable broth, tomato paste, and thyme.",
    "Bring the mixture to a boil, then reduce the heat to low and simmer for 1 hour.",
    "Season with salt and pepper to taste.",
    "Serve hot, garnished with fresh herbs if desired."
  ],
