  "ingredients": [
    {
      "name": "grass-fed beef strips",
      "amount": "1 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "coconut oil",
      "amount": "2 tablespoons",
      "notes": "for kadhai"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "jerk seasoning",
      "amount": "2 teaspoons",
      "notes": "store-bought or homemade"
    },
    {
      "name": "grilled beef seasoning",
      "amount": "1 teaspoon",
      "notes": "store-bought or homemade"
    },
    {
      "name": "tomato paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "beef broth",
      "amount": "1 cup"
    },
    {
      "name": "coconut milk",
      "amount": "1/2 cup"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "fresh cilantro",
      "amount": "1/4 cup",
      "notes": "chopped, for garnish"
    }
  ],
  "instructions": [
    "Heat 1 tablespoon of coconut oil in a kadhai over medium-high heat.",
    "Add the chopped onion and cook until browned, about 5 minutes.",
    "Add the minced garlic and cook for 1 minute, until fragrant.",
    "Add the jerk seasoning and grilled beef seasoning, and cook for 1 minute, stirring constantly.",
    "Add the beef strips and cook until browned, about 5 minutes.",
    "Add the tomato paste and cook for 1 minute, stirring constantly.",
    "Add the beef broth and bring to a simmer.",
    "Reduce heat to low and let cook for 15 minutes, or until the beef is tender.",
    "Stir in the coconut milk and cook for an additional 2 minutes.",
    "Season with salt and black pepper to taste.",
    "Serve hot, garnished with chopped fresh cilantro."
  ],
