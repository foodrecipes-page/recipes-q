  "ingredients": [
    {
      "name": "1 x 250g ready rolled shortcrust pastry",
      "amount": "",
      "notes": ""
    },
    {
      "name": "1/2 cup fermented long-fermentation-dough papaya",
      "amount": "",
      "notes": "shop-bought or homemade"
    },
    {
      "name": "2 tablespoons lime juice",
      "amount": "",
      "notes": ""
    },
    {
      "name": "1 tablespoon fish sauce",
      "amount": "",
      "notes": "optional"
    },
    {
      "name": "1 teaspoon palm sugar",
      "amount": "",
      "notes": ""
    },
    {
      "name": "1/2 teaspoon grated garlic",
      "amount": "",
      "notes": ""
    },
    {
      "name": "1/4 teaspoon grated ginger",
      "amount": "",
      "notes": ""
    },
    {
      "name": "1/4 cup chopped peanuts",
      "amount": "",
      "notes": ""
    }
  ],
  "instructions": [
    "Preheat an oven to 200°C.",
    "Unroll the shortcrust pastry and place it on a baking sheet.",
    "Bake the pastry for 10 minutes, or until crispy and golden.",
    "Meanwhile, peel and remove the seeds from the fermented papaya.",
    "Chop the papaya into small pieces and place it in a large bowl.",
    "Add the lime juice, fish sauce, palm sugar, garlic, and ginger to the bowl with the papaya.",
    "Mix the dressing until the papaya is well-coated.",
    "Crush the baked pastry into small pieces and add it to the bowl with the papaya.",
    "Stir in the chopped peanuts.",
    "Taste and adjust the dressing as needed.",
    "Serve the som-tum immediately, garnished with extra peanuts if desired."
  ],
