      "amount": "1 1/2 cups"
    },
    {
      "name": "almond paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "whole wheat flour",
      "amount": "1 tablespoon"
    },
    {
      "name": "unsalted butter",
      "amount": "2 tablespoons"
    },
    {
      "name": "fresh parsley",
      "amount": "1 tablespoon"
    },
    {
      "name": "mustard powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "smoked paprika",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "gouda cheese",
      "amount": "6 ounces"
    }
  ],
  "instructions": [
    "preheat the oven to 375°f (190°c).",
    "in a claypot, combine the petit pois, almond paste, whole wheat flour, unsalted butter, fresh parsley, mustard powder, smoked paprika, salt, and black pepper.",
    "mix well to combine.",
    "place the claypot in a bain-marie and cover with foil.",
    "bake for 25 minutes.",
    "remove the foil and top with the gouda cheese.",
    "return to the oven and bake for an additional 5 minutes, or until the cheese is melted and bubbly.",
    "serve hot and enjoy!"
  ],
