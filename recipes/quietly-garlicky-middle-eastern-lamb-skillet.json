      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "garlic",
      "amount": "6 cloves",
      "notes": "minced"
    },
    {
      "name": "shio-koji",
      "amount": "2 tablespoons"
    },
    {
      "name": "baguette",
      "amount": "1 loaf",
      "notes": "cut into 1-inch cubes"
    },
    {
      "name": "yogurt",
      "amount": "1 cup"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large cast-iron skillet over medium-high heat.",
    "Add the lamb pieces and cook until browned on all sides, about 5 minutes.",
    "Add the minced garlic and cook for 1 minute, until fragrant.",
    "Add the shio-koji and cook for 1 minute, until dissolved.",
    "Add the baguette cubes and cook until toasted, about 2 minutes.",
    "Stir in the yogurt and cook until heated through.",
    "Season with salt and black pepper to taste.",
    "Serve hot, garnished with chopped fresh parsley or cilantro if desired."
  ],
