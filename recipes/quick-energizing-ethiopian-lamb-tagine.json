      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "dasima-kombu",
      "amount": "2 pieces",
      "notes": "dried"
    },
    {
      "name": "butter",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "berbere spice",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "chicken broth",
      "amount": "1 cup"
    }
  ],
  "instructions": [
    "Heat the butter in a large Dutch oven over medium heat.",
    "Add the onion and cook until softened, about 5 minutes.",
    "Add the garlic and ginger and cook for 1 minute.",
    "Add the lamb and cook until browned on all sides, about 5 minutes.",
    "Add the dasima-kombu, berbere spice, salt, and black pepper, and stir to combine.",
    "Add the chicken broth and bring to a boil.",
    "Reduce the heat to low and simmer, covered, for 20 minutes.",
    "Remove the dasima-kombu and discard.",
    "Deglaze the pot with a little water and serve hot.",
    "Ensure poultry is cooked to an internal temperature of 74°C / 165°F (juices run clear, no pink remaining) before serving."
  ],
