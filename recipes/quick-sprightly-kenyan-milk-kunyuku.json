{
  "title": "Quick-Sprightly Kenyan Milk Kunyuku",
  "description": "A spicy, springy Kenyan dish featuring semi-skimmed milk, easy to make in a ttukbaegi earthenware cookware.",
  "cuisine": "Kenyan",
  "diet": [
    "ovo-vegetarian"
  ],
  "meal": "breakfast",
  "ingredients": [
    {
      "name": "semi-skimmed milk",
      "amount": "1 liter"
    },
    {
      "name": "cornmeal",
      "amount": "2 cups"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon",
      "notes": "optional"
    },
    {
      "name": "cayenne pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "finely chopped"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "vegetable oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "water",
      "amount": "1 cup"
    }
  ],
  "instructions": [
    "Combine milk, cornmeal, salt, cayenne pepper in a large bowl.",
    "Add the chopped onion and minced garlic to the bowl and mix well.",
    "Gradually add the water to the bowl and stir until the mixture is smooth.",
    "Heat the vegetable oil in a ttukbaegi earthenware cookware over medium heat.",
    "Pour the cornmeal mixture into the cookware and cook for 5 minutes.",
    "Use a spatula to gently fold the edges of the mixture towards the center.",
    "Continue cooking and folding for 10-12 minutes or until the Kunyuku is springy and well cooked.",
    "Serve the Kunyuku hot with your favorite accompaniments."
  ],
