  "ingredients": [
    {
      "name": "eggplant",
      "amount": "2 medium",
      "notes": "cut into 1-inch cubes"
    },
    {
      "name": "horseradish",
      "amount": "1/4 cup",
      "notes": "fermented"
    },
    {
      "name": "feta cheese",
      "amount": "1/2 cup",
      "notes": "crumbly"
    },
    {
      "name": "kalamata olives",
      "amount": "1/4 cup",
      "notes": "pitted"
    },
    {
      "name": "artichoke hearts",
      "amount": "1/4 cup",
      "notes": "canned"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "garlic",
      "amount": "1 clove",
      "notes": "minced"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the air fryer to 400 degrees Fahrenheit.",
    "Thread the eggplant cubes onto skewers, leaving a small space between each cube.",
    "In a bowl, mix together the horseradish, feta cheese, kalamata olives, artichoke hearts, lemon juice, olive oil, garlic, salt, and pepper.",
    "Brush the mixture onto the eggplant cubes.",
    "Place the skewers in the air fryer basket and cook for 10 minutes, shaking halfway through.",
    "Check the eggplant for tenderness and cook for an additional 2 minutes if necessary.",
    "Remove the skewers from the air fryer and serve hot.",
    "Garnish with additional feta cheese and olives if desired."
  ],
