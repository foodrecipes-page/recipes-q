{
  "title": "Quickly Air Fried Mediterranean Eggplant Skewers",
  "description": "A lacto-vegetarian-friendly Mediterranean dish featuring fermented horseradish and air-fried eggplant, perfect for a midnight craving.",
  "cuisine": "Mediterranean",
  "diet": [
    "lacto-vegetarian"
  ],
