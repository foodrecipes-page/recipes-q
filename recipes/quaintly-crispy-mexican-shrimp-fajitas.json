      "name": "shrimp",
      "amount": "1 pound",
      "notes": "peeled and deveined"
    },
    {
      "name": "dried apricots",
      "amount": "1/2 cup",
      "notes": "chopped"
    },
    {
      "name": "beurre-monte",
      "amount": "2 tablespoons"
    },
    {
      "name": "malty beer",
      "amount": "1/4 cup"
    },
    {
      "name": "olive oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "sliced"
    },
    {
      "name": "tortillas",
      "amount": "8 small",
      "notes": "flour or corn"
    },
    {
      "name": "salt",
      "amount": "to taste"
    },
    {
      "name": "pepper",
      "amount": "to taste"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large skillet over medium-high heat.",
    "Add the garlic and onion to the skillet and cook until the onion is translucent.",
    "Add the shrimp to the skillet and cook until they are pink and fully cooked.",
    "Add the chopped dried apricots, malty beer, and beurre-monte to the skillet and stir to combine.",
    "Season the mixture with salt and pepper to taste.",
    "Warm the tortillas by wrapping them in a damp paper towel and microwaving for 20-30 seconds.",
    "Assemble the fajitas by placing a portion of the shrimp and apricot mixture onto each tortilla.",
    "Serve the fajitas in a bento-box and enjoy."
  ],
