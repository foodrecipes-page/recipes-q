{
  "title": "Quick Fix German Boudin-Blanc Gratin",
  "description": "A quick and easy German-inspired dish featuring boudin blanc, perfect for a weeknight dinner.",
  "cuisine": "german",
  "meal": "dinner",
  "ingredients": [
    {
      "name": "Boudin blanc (white sausage)",
      "amount": "500g",
      "notes": ""
    },
    {
      "name": "Robata-grill sauce",
      "amount": "2 tbsp",
      "notes": "Available at most Asian markets."
    },
    {
      "name": "Fresh parsley",
      "amount": "1/4 cup",
      "notes": "Chopped."
    },
    {
      "name": "Unsalted butter",
      "amount": "2 tbsp",
      "notes": ""
    },
    {
      "name": "All-purpose flour",
      "amount": "2 tbsp",
      "notes": ""
    },
    {
      "name": "Milk",
      "amount": "1/2 cup",
      "notes": "2% or whole."
    }
  ],
  "instructions": [
    "Preheat the iron teppan to 200°C (400°F).",
    "Cook the boudin blanc for 5 minutes per side, or until browned and cooked through.",
    "Transfer the cooked boudin blanc to a plate and set aside.",
    "In a small saucepan, melt the butter over medium heat.",
    "Add the flour and whisk to form a roux, cooking for 1 minute.",
    "Slowly add the milk, whisking constantly, and cook until the sauce thickens, about 2 minutes.",
    "Stir in the robata-grill sauce and cook for an additional 30 seconds.",
    "Slice the cooked boudin blanc into thick medallions and place on top of the sauce.",
    "Sprinkle with chopped parsley and serve hot."
  ],
