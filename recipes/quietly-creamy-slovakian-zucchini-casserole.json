{
  "title": "Quietly Creamy Slovakian Zucchini Casserole",
  "description": "A salty, creamy, and cozy Slovakian dish featuring zucchini, infused oil, and anti-inflammatory friendly ingredients, served in a bamboo tray.",
  "cuisine": "Slovakian",
  "diet": [
    "gluten-free",
    "vegetarian"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "zucchini",
      "amount": "2 medium",
      "notes": "sliced into 1/4 inch thick rounds"
    },
    {
      "name": "infused oil",
      "amount": "1/4 cup",
      "notes": "with turmeric and ginger"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "sour cream",
      "amount": "1 cup",
      "notes": "full fat"
    },
    {
      "name": "feta cheese",
      "amount": "1/2 cup",
      "notes": "crumbly"
    },
    {
      "name": "salt",
      "amount": "1 tsp",
      "notes": "preferably Himalayan pink salt"
    },
    {
      "name": "black pepper",
      "amount": "1/2 tsp",
      "notes": "freshly ground"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large skillet, heat the infused oil over medium heat.",
    "Add the chopped onion and cook until translucent, about 5 minutes.",
    "Add the minced garlic and cook for an additional minute.",
    "In a large bowl, combine the sliced zucchini, cooked onion and garlic, sour cream, feta cheese, salt, and black pepper.",
    "Mix well to combine, then transfer the mixture to a bamboo tray.",
    "Top with additional feta cheese and chopped parsley.",
    "Bake for 30 minutes, or until the casserole is golden brown and the zucchini is tender."
  ],
