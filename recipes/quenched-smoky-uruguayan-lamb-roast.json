{
  "title": "Quenched Smoky Uruguayan Lamb Roast",
  "description": "A dense, smoky lamb roast infused with hojicha tea and katsuramuki, served on a bamboo tray for a romantic date-night experience.",
  "cuisine": "Uruguayan",
