      "notes": "boneless cut for even cooking"
    },
    {
      "name": "hojicha tea",
      "amount": "200ml",
      "notes": " brewed, cooled"
    },
    {
      "name": "katsuramuki",
      "amount": "2 pieces",
      "notes": " sliced crosswise"
    },
    {
      "name": "garlic cloves",
      "amount": "6",
