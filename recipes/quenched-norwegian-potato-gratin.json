{
  "title": "Quenched Norwegian Potato Gratin",
  "description": "A chewy, umami rich potato gratin with a buttery appleton rum glaze, topped with a crisp en-croute crust.",
  "cuisine": "Norwegian",
  "diet": [
    "lacto-vegetarian-friendly"
