      "name": "potatoes",
      "amount": "3 lbs",
      "notes": "peeled and sliced 1/4 inch thick"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "thinly sliced"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "butter",
      "amount": "2 tbsp",
      "notes": "for sauce"
    },
    {
      "name": "heavy cream",
      "amount": "1 cup"
    },
    {
      "name": "Jarlsberg cheese",
      "amount": "1 cup",
      "notes": "grated"
    },
    {
      "name": "breadcrumbs",
      "amount": "1/2 cup"
    },
    {
      "name": "butter",
      "amount": "1 tbsp",
      "notes": "melted for breadcrumbs"
    },
    {
      "name": "appleton rum",
      "amount": "2 tbsp"
    },
    {
      "name": "salt and pepper",
      "amount": "to taste"
    }
  ],
  "instructions": [
    "Preheat oven to 375°F.",
    "In a saucepan, melt 2 tbsp butter and add garlic, cooking until fragrant.",
    "Stir in heavy cream and bring to a gentle simmer, then pour into a baking dish.",
    "Layer sliced potatoes, onions, and sprinkle with salt and pepper, then pour cream mixture over.",
    "Bake for 30 minutes, then remove and spread grated cheese evenly over the top.",
    "Sprinkle breadcrumb mixture over the cheese.",
    "Drizzle appleton rum over the breadcrumbs and bake for an additional 15 minutes until golden and crispy.",
    "Let the gratin rest for 5 minutes before serving."
  ],
