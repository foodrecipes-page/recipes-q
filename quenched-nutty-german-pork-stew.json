  "instructions": [
    "Heat oil in a large Dutch oven over medium-high heat.",
    "Sear the pork shoulder until browned on all sides, about 5 minutes.",
    "Remove the pork from the pot and set aside.",
    "Add the onion and garlic to the pot and cook until the onion is translucent.",
    "Add the carrots and potatoes to the pot and cook for 5 minutes.",
    "Add the flour to the pot and cook for 1 minute.",
    "Add the beef broth, vinegar, thyme, salt, and pepper to the pot.",
    "Return the pork to the pot and bring to a boil.",
